# Gateway .env
#
# JWT 검증을 켜려면:
# 1. auth-service 에서 ./gradlew generateJwtKeys 실행 (이미 했다면 생략)
# 2. SECURITY_JWT_ENABLED=true
# 3. JWT_PUBLIC_KEY_LOCATION 은 auth-service 의 jwt-public.pem 경로

# 로컬 Discovery (선택 — gateway 단독 테스트 시)
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

# JWT off: Gateway 전 구간 permitAll (로컬 초기 연동)
SECURITY_JWT_ENABLED=false

# JWT on 시 (auth-service keys 와 쌍)
# SECURITY_JWT_ENABLED=true
# JWT_PUBLIC_KEY_LOCATION=file:../auth-service/keys/jwt-public.pem
