# Gateway .env
#
# 이 파일을 .env 로 복사하면 application-local.yml 의
# spring.config.import(optional:file:.env[.properties]) 로 로드된다.
#
# 사전 준비: auth-service 에서 ./gradlew generateJwtKeys (이미 했다면 생략)

# JWT on — 기본값(application.yml: SECURITY_JWT_ENABLED:true).
# 회원가입은 Gateway 가 JWT 를 검증해야 X-Member-Uuid 를 주입하고,
# 그래야 member-service 프로필(닉네임) 저장이 성공한다.
# prod 프로필에서는 JWT 비활성화가 기동 실패로 차단된다.
SECURITY_JWT_ENABLED=true
JWT_PUBLIC_KEY_LOCATION=file:../auth-service/keys/jwt-public.pem
AUTH_COOKIE_ACCESS_NAME=vh_access_token

# 로컬 Discovery (선택 — gateway 단독 테스트 시)
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka
