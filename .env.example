# Gateway Server 환경변수 예시
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 설정하세요.

# dev / prod 프로필에서 필수
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery:8761/eureka

# 선택 (기본값: 8000)
# SERVER_PORT=8000

# JWT 인증 활성화 시 (Auth Service 구현 후, RSA 비대칭키 방식)
# SECURITY_JWT_ENABLED=true
# JWT_PUBLIC_KEY=          # PEM 형식 RSA 공개키 (직접 설정)
# JWT_PUBLIC_KEY_LOCATION= # RSA 공개키 파일 경로 (classpath: 또는 file:)
